# Dispoo V1 — configuration
# Copiez ce fichier vers `.env` (jamais commité) pour le dev local,
# ou renseignez ces variables dans Vercel → Settings → Environment Variables.
#
# Base Postgres (Vercel Postgres, Neon, Supabase…) — l'une des deux suffit.
# Sans base : l'app fonctionne en local (stockage mémoire), et répond 503
# explicite en production tant que la base n'est pas branchée.
POSTGRES_URL=postgres://user:password@host:5432/dispoo?sslmode=require
# DATABASE_URL=

# Démo sans base (données perdues au redémarrage, réservé aux previews) :
# DISPOO_ALLOW_MEMORY=1

# URL publique stable (pré-remplit og:* et le lien partagé ; sinon origine courante) :
# APP_URL=https://dispoo.app

PORT=3000
